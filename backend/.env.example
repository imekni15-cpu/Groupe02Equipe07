# Copie ce fichier en .env (jamais commité) puis remplis les valeurs.
PORT=5000

# Origines autorisées (front web), séparées par des virgules
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Projet Firebase partagé par l'équipe
FIREBASE_PROJECT_ID=campussave-950cd

# Chemin vers la clé de compte de service (fichier non commité, à placer dans backend/)
# Firebase Console > Paramètres du projet > Comptes de service > Générer une nouvelle clé privée
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Clé API Web du projet (Paramètres du projet > Général > Clé API Web).
# Sert à vérifier email + mot de passe via l'API REST Firebase Auth au login.
FIREBASE_WEB_API_KEY=

# Uniquement pour le script createAdmin.js
ADMIN_NAME=Admin CampusSave
ADMIN_EMAIL=
ADMIN_PASSWORD=
