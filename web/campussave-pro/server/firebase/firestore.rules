rules_version = '2';
// Toutes les lectures et écritures passent par l'API Express (SDK Admin, qui ignore ces règles).
// Aucun accès direct depuis un navigateur ou une application mobile : les règles refusent tout.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
