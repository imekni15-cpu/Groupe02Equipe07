# ───────── Serveur ─────────
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
# Secrets : en production, mettre de longues valeurs aléatoires
JWT_SECRET=change-moi-en-production
OTP_SECRET=change-moi-aussi

# ───────── E-mail de confirmation (Gmail) ─────────
# 1) Compte Google > Sécurité > activer la validation en 2 étapes
# 2) Compte Google > Sécurité > "Mots de passe d'application" > créer "CampusSave"
# 3) Coller ici l'adresse Gmail et le mot de passe d'application à 16 caractères
#    (JAMAIS le vrai mot de passe Gmail). Sans ces 2 lignes : mode démo (le code s'affiche dans l'interface).
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CampusSave <ton.adresse@gmail.com>

# Autre fournisseur SMTP (optionnel) : SMTP_HOST, SMTP_PORT, SMTP_SECURE=true|false

# ───────── Démo ─────────
# Si renseigné, le compte étudiant de démo utilise CETTE adresse : tu reçois les vrais codes dans ta boîte Gmail.
DEMO_EMAIL=

# ───────── Firebase (Authentication + Firestore) ─────────
# Sans ces lignes : mode local (fichier JSON, mots de passe hachés). Avec elles : les comptes vivent dans
# Firebase Authentication et les données dans Firestore (collections users, shops, offers, orders, favorites, meta).
# 1) Console Firebase > Paramètres du projet > Comptes de service > « Générer une nouvelle clé privée »
#    et enregistrer le fichier sous server/serviceAccountKey.json (déjà ignoré par Git : NE JAMAIS le déposer sur GitHub).
# 2) Console Firebase > Authentication > Méthode de connexion > activer « E-mail/Mot de passe ».
# 3) Console Firebase > Firestore Database > créer la base, puis coller les règles de server/firebase/firestore.rules.
# 4) Console Firebase > Paramètres du projet > Général > « Clé API Web » (cette clé n'est pas secrète).
# FIREBASE_SERVICE_ACCOUNT=./serviceAccountKey.json
# FIREBASE_WEB_API_KEY=
# Sur un hébergeur sans fichier : colle le contenu JSON de la clé ici à la place de FIREBASE_SERVICE_ACCOUNT.
# FIREBASE_SERVICE_ACCOUNT_JSON=
# Appli mobile Flutter : accepter directement un ID token Firebase (la connexion mobile n'utilise alors PAS le code e-mail).
# FIREBASE_ID_TOKEN_AUTH=true

# ───────── Paiement en ligne Konnect (bac à sable) ─────────
# Compte gratuit sur https://konnect.network : créer un portefeuille « sandbox », puis copier l'identifiant du
# portefeuille et la clé API. Sans ces deux lignes : paiement simulé avec des cartes de test.
KONNECT_API_KEY=
KONNECT_WALLET_ID=
# Production uniquement : KONNECT_BASE_URL=https://api.konnect.network/api/v2
# Si l'API est accessible depuis Internet (hébergement), Konnect peut prévenir le serveur même si l'étudiant ferme son navigateur :
# PUBLIC_API_URL=https://mon-api.exemple.tn
